{
  "name": "dev-ia-p12",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "db:start": "docker compose up -d --wait",
    "db:local": "node --env-file=.env.local scripts/local-postgres.js",
    "db:init": "node --env-file=.env.local scripts/init-demo.js",
    "db:stop": "docker compose down",
    "db:reset": "node --env-file=.env.local src/database/seed.js"
  },
  "dependencies": {
    "next": "15.5.28",
    "openai": "7.43.0",
    "pg": "^8.16.3",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "0.0.1",
    "sql-template-strings": "^2.2.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.64.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "15.5.28"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
